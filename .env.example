# Copy this file to ".env" and fill in your own keys.
# At least one provider is required. OpenRouter is the primary provider and
# Gemini is the fallback (the order is defined in src/matcher.py).
#
# Every value below the API keys is OPTIONAL: each has a sensible default in
# code and is only read from here if you set it. Nothing tunable is hardcoded —
# uncomment and change anything you want to adjust.

# ============================================================================
# API keys (required: at least one)
# ============================================================================

# OpenRouter API key — https://openrouter.ai/keys (primary provider)
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini API key — https://aistudio.google.com/app/apikey (fallback)
GEMINI_API_KEY=your_gemini_key_here

# ============================================================================
# LLM models
# ============================================================================

# Pin a SINGLE OpenRouter model (highest priority; overrides the list below).
# Example: OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_MODEL=

# Override the whole OpenRouter model list (comma-separated, tried in order).
# OPENROUTER_MODELS=openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free

# Auto-append every currently-free OpenRouter model (pricing == 0) as extra
# fallbacks after the curated list, discovered from OpenRouter's public /models
# API. Keeps the chain working as free model IDs come and go. Default: true.
# OPENROUTER_AUTO_FREE_MODELS=true

# Gemini model used for the fallback provider.
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# LLM call behavior
# ============================================================================

# Sampling temperature for both providers (0.0 = deterministic).
# LLM_TEMPERATURE=0.1

# Max output tokens for OpenRouter responses (room for reasoning + JSON).
# OPENROUTER_MAX_TOKENS=2000

# HTTP timeout (seconds) for OpenRouter requests.
# LLM_REQUEST_TIMEOUT=60

# How many times to walk the full provider chain before giving up and falling
# back to the local embedding match score. Kept low: sleeping minutes per job on
# a saturated free pool made runs take hours, and the wait can't un-congest it.
# LLM_MAX_PROVIDER_CYCLES=2

# Seconds to wait between full-chain retry cycles on quota/limit errors.
# LLM_QUOTA_RETRY_WAIT=5

# ============================================================================
# Contract (CLT) classification — LOCAL, no LLM
# ============================================================================
# CLT vs PJ/estágio is decided entirely by high-precision regex signals
# (src/text_signals.py); there are no tunables. Default-CLT: a job is discarded
# only on an explicit non-CLT signal (contractor/PJ/USD-hourly or internship).

# ============================================================================
# Local vector scoring (embeddings) — powers score_vetor_desc, score_title,
# the embedding scope gate, and the LLM-failure fallback
# ============================================================================

# model2vec model (chonkie backend). MUST be multilingual: the profile is PT and
# jobs come in PT+EN. potion-base-32M (English) scored language, not relevance.
# LOCAL_MATCH_MODEL=minishlab/potion-multilingual-128M

# Cosine-similarity band mapped to the 0-100 fallback score (below FLOOR -> 0,
# above CEIL -> 100). Tuned for the OLD model; recalibrate for the multilingual
# one (relevant jobs measured ~0.38-0.50 raw).
# LOCAL_MATCH_SIM_FLOOR=0.30
# LOCAL_MATCH_SIM_CEIL=0.70

# ============================================================================
# Embedding scope gate (main.analyze_and_filter_jobs)
# ============================================================================
# A job is dropped as out-of-scope only when BOTH signals are weak: title far
# from every termos_busca role (score_title) AND description far from the CV
# (score_vetor_desc). Raw cosines 0-1. Lower = more permissive (keeps more).
# SCOPE_TITLE_MIN=0.40
# SCOPE_DESC_MIN=0.40

# ============================================================================
# Relevance filter — drives the "relevant" flag the web UI filters on
# ============================================================================

# Minimum CLT confidence (score_clt, 0.0-1.0). Jobs with a non-numeric / "N/A"
# CLT score are always flagged not-relevant.
# REPORT_MIN_CLT_SCORE=0.7

# Minimum profile match score (match_score, 0-100).
# REPORT_MIN_MATCH_SCORE=70

# ============================================================================
# Scraper (LinkedIn collection)
# ============================================================================

# Retries on a 429 / network error per request.
# SCRAPER_MAX_RETRIES=5

# Seconds to wait between retry attempts.
# SCRAPER_RETRY_WAIT=5

# HTTP timeout (seconds) for scraper requests.
# SCRAPER_REQUEST_TIMEOUT=15

# Max search-result pages to walk per term/filter.
# SCRAPER_MAX_PAGES=10

# Friendly random pause between requests (seconds) to avoid 429.
# SCRAPER_MIN_REQUEST_DELAY=1.0
# SCRAPER_MAX_REQUEST_DELAY=3.0

# ============================================================================
# Run control / scheduler (webapp.py in-app scheduler; src/run_controller.py)
# ============================================================================

# Master switch for the dashboard's automatic recurring runs. Default: true.
# "false" = manual only (trigger from the "Rodar agora" button).
# SCHEDULER_ENABLED=true

# Seconds between automatic runs. Default 21600 (6h); 0 = manual only (no auto).
# RUN_INTERVAL_SECONDS=21600

# Fire the first automatic run immediately on start ("true") or wait one interval
# first ("false"). Default: false.
# RUN_ON_START=true

# Web UI (webapp.py) bind host/port for marking jobs as viewed/applied.
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# ============================================================================
# File paths
# ============================================================================

# Search/profile configuration file (YAML).
# KEYWORDS_CONFIG_PATH=config/keywords.yaml

# Where the seen-jobs history is persisted (JSON).
# HISTORY_PATH=vagas_historico.json

# Where the in-app run controller (webapp.py) persists run/progress state (JSON).
# Separate from the history; safe to delete (rebuilt on next run). In Docker point
# it into ./data alongside the history.
# RUN_STATE_PATH=run_state.json
