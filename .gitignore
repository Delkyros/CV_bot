# Environments
.venv
__pycache__/
*.pyc

# Local tooling
.claude/

# Secrets
.env

# Docker: the real compose holds API keys — commit docker-compose.example.yml instead
docker-compose.yml

# Local user configuration (use config/keywords.example.yaml as a template)
config/keywords.yaml

# Runtime outputs (generated on each run)
vagas_filtradas.md
vagas_historico.json
vagas_historico.backup-*.json
data/stale-root-*
run_state.json
*.xlsx

# Match-quality loop artifacts (spec 002) — derived from personal history,
# regenerable by eval_scores.py / train_meta_model.py; never commit.
data/golden_set.json
data/eval_report.md
data/meta_model.joblib
data/meta_model_report.json
*.joblib

# Local embedding-model cache (downloaded on first use of the match fallback,
# src/local_match.py) — regenerable, never commit the ~30MB model binaries.
hf-cache/
data/hf-cache/
